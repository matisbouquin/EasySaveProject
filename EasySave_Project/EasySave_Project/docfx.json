{
    "metadata": [
      {
        "src": [
          {
            "files": ["**/*.cs"],
            "exclude": ["**/bin/**", "**/obj/**"]
          }
        ],
        "dest": "documentation"
      }
    ],
    "build": {
      "content": [
        {
          "files": ["**/*.md", "documentation/**", "index.md"]
        }
      ],
      "output": "_site"
    }
  }
  